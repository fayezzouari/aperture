# Copy to .env and change everything marked CHANGE ME before this leaves your laptop.

# ------------------------------------------------------------------- identity
AP_ENV=dev
AP_INSTANCE_NAME=Aperture
AP_PUBLIC_URL=http://localhost:8080
AP_LOG_LEVEL=INFO

# ------------------------------------------------------------------- secrets
# CHANGE ME - signs session tokens. Rotating it signs everyone out.
AP_JWT_SECRET=dev-only-change-me
# CHANGE ME - shared secret between the control plane and its runtimes.
AP_RUNTIME_INTERNAL_TOKEN=dev-only-runtime-token
# CHANGE ME - the first admin. Change the password after the first sign-in.
AP_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
AP_BOOTSTRAP_ADMIN_PASSWORD=aperture

POSTGRES_PASSWORD=aperture
MINIO_ROOT_USER=aperture
MINIO_ROOT_PASSWORD=aperture-secret
GRAFANA_PASSWORD=aperture

# --------------------------------------------------------------------- ports
WEB_PORT=8080
LANDING_PORT=8081
API_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# ------------------------------------------------------------------- serving
RUNTIME_REPLICAS=2
AP_RUNTIME_DEVICE=auto
AP_MAX_LOADED_VERSIONS=8
AP_INFER_WORKERS=2
AP_CACHE_MAX_GB=32
AP_MAX_PAYLOAD_MB=32
AP_MAX_BATCH_IMAGES=64
AP_MAX_UPLOAD_MB=8192

# Encryption at rest for object storage. Empty = rely on the storage layer
# (encrypted volume, or an S3 bucket with default encryption). Set to AES256
# only against AWS S3 or a KMS-backed MinIO - plain MinIO rejects it.
AP_S3_SSE=

# ------------------------------------------------------------- observability
AP_CAPTURE_SAMPLE_RATE=0.05
AP_CAPTURE_RETENTION_DAYS=30
AP_OTEL_ENABLED=false

# ---------------------------------------------------------------------- SSO
AP_OIDC_ENABLED=false
AP_OIDC_ISSUER=
AP_OIDC_CLIENT_ID=
AP_OIDC_CLIENT_SECRET=
AP_OIDC_ADMIN_GROUPS=aperture-admins
AP_OIDC_DEVELOPER_GROUPS=aperture-developers

AP_LDAP_ENABLED=false
AP_LDAP_URL=
AP_LDAP_BIND_DN=
AP_LDAP_BIND_PASSWORD=
AP_LDAP_USER_BASE_DN=
AP_LDAP_USER_FILTER=(uid={username})

# ------------------------------------------------------------------- alerts
AP_SMTP_HOST=
AP_SMTP_PORT=25
AP_SMTP_FROM=aperture@localhost

# --------------------------------------------------------------------- SSRF
# Empty = any public host may be fetched for image_url; private ranges are
# always refused. Set a comma-separated allowlist to lock it down.
AP_REMOTE_URL_ALLOWLIST=

# ------------------------------------------------------ roboflow compat
# Answer Roboflow-shaped workflow calls (POST /infer/workflows/{workspace}/{workflow})
# with Aperture models, so a client already calling Roboflow moves over by
# changing one base URL. Migration aid, off by default.
# AP_ROBOFLOW_COMPAT_WORKFLOWS overrides which models stand in for each workflow;
# empty keeps the built-in mapping. Matched by workflow-id prefix.
AP_ROBOFLOW_COMPAT_ENABLED=false
AP_ROBOFLOW_COMPAT_WORKFLOWS=

# Roboflow import: read a version's classes and download its weights.
# Only ever sent to Roboflow. An import request may carry its own key instead.
AP_ROBOFLOW_API_KEY=
